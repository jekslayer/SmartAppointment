{
  "framework": "angular",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/smart-appointment-system/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/appointment-reminders", "schedule": "0 1 * * *" }
  ]
}
